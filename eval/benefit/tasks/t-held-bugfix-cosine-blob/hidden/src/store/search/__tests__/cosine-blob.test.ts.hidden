import { describe, expect, it } from "vitest";
import { cosineDistance } from "../candidates.js";

/** A buffer holding the floats, placed `offset` bytes into a larger allocation. */
function blobAt(values: number[], offset: number): Buffer {
  const floats = new Float32Array(values);
  const big = Buffer.alloc(offset + floats.byteLength + 3);
  Buffer.from(floats.buffer).copy(big, offset);
  return big.subarray(offset, offset + floats.byteLength);
}

describe("cosineDistance on a stored vector blob", () => {
  const q = new Float32Array([1, 0, 0, 0]);

  it("is 0 for the same direction and 1 for orthogonal vectors", () => {
    expect(cosineDistance(q, blobAt([1, 0, 0, 0], 0))).toBeCloseTo(0, 6);
    expect(cosineDistance(q, blobAt([0, 1, 0, 0], 0))).toBeCloseTo(1, 6);
    expect(cosineDistance(q, blobAt([-1, 0, 0, 0], 0))).toBeCloseTo(2, 6);
  });

  it("gives the same distance when the blob does not start on a 4-byte boundary", () => {
    const values = [0.5, 0.5, 0.5, 0.5];
    const aligned = cosineDistance(q, blobAt(values, 0));
    for (const offset of [1, 2, 3, 5]) {
      expect(cosineDistance(q, blobAt(values, offset))).toBeCloseTo(aligned, 6);
    }
  });
});
