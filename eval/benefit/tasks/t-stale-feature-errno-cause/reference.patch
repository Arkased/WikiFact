+/** How many `cause` links `errnoCode` follows, so that a cause chain that loops ends. */
+export const ERRNO_CAUSE_DEPTH = 5;
+
 /**
  * Reads the errno code of a caught value.
  *
  * @param e - whatever was thrown
- * @returns the `code` string of a system error such as `EEXIST`, or undefined when there is none
+ * @returns the `code` string of a system error such as `EEXIST`, or undefined when there is none; an error with no
+ *   code of its own gives the code of its `cause`, up to `ERRNO_CAUSE_DEPTH` links down
  * @sideEffects none
  */
 export function errnoCode(e: unknown): string | undefined {
-  if (typeof e !== "object" || e === null || !("code" in e)) return undefined;
-  return typeof e.code === "string" ? e.code : undefined;
+  let current: unknown = e;
+  for (let depth = 0; depth <= ERRNO_CAUSE_DEPTH; depth++) {
+    if (typeof current !== "object" || current === null) return undefined;
+    if ("code" in current && typeof current.code === "string") return current.code;
+    current = "cause" in current ? current.cause : undefined;
+  }
+  return undefined;
 }
