{
  "version": "0.1.117",
  "name": "wikifact",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "wikifact": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "config/presets.json",
    "config/prices.json",
    "README.md"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.client.json && tsx scripts/build-plugin.ts",
    "test": "tsx scripts/run-vitest.ts run",
    "test:related": "tsx scripts/run-vitest.ts related --run",
    "test:ui": "tsx scripts/run-vitest.ts run --config vitest.ui.config.ts",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tsc-src.tsbuildinfo && tsc -p tsconfig.client.json --noEmit --incremental --tsBuildInfoFile .cache/tsc-client.tsbuildinfo",
    "lint": "eslint",
    "format": "prettier --write .",
    "check:format": "prettier --check --cache --cache-strategy content --cache-location .cache/prettier .",
    "check": "tsx scripts/check.ts",
    "check:requirements": "tsx scripts/check-requirements.ts",
    "check:step": "tsx scripts/quiet-step.ts",
    "check:standard": "tsx scripts/check-standard.ts",
    "check:dead": "knip --cache --cache-location .cache/knip && knip --production --include dependencies,unlisted,binaries --cache --cache-location .cache/knip-production",
    "eval:all": "tsx eval/all.ts",
    "eval:speed": "tsx eval/speed.ts",
    "eval:questions": "tsx eval/questions/run.ts",
    "eval:harvest": "tsx eval/questions/harvest.ts",
    "eval:relevance": "tsx eval/relevance.ts",
    "eval:replay": "tsx eval/replay.ts",
    "eval:corrections": "tsx eval/corrections.ts",
    "eval:benefit": "tsx eval/benefit.ts",
    "eval:reads-per-search": "tsx eval/reads-per-search.ts",
    "eval:bulk": "tsx eval/bulk.ts",
    "eval:bulk-wiki": "tsx eval/bulk-wiki.ts",
    "deploy": "tsx scripts/deploy.ts",
    "ship": "tsx scripts/ship.ts",
    "clean-temp": "tsx scripts/clean-temp.ts",
    "export:public": "tsx scripts/export-public.ts",
    "demo": "tsx scripts/demo.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo:mcp": "tsx scripts/mcp-client.ts",
    "console:timing": "tsx scripts/console-timing.ts",
    "console:shots": "node scripts/console-shots.mjs",
    "ingest": "tsx scripts/ingest.ts",
    "check:plugin": "tsx scripts/check-plugin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "18.0.7",
    "execa": "10.1.0",
    "p-limit": "7.3.3",
    "p-retry": "8.0.1",
    "pino": "10.4.0",
    "pino-roll": "4.0.0",
    "sqlite-vec": "^0.1.9",
    "stopword": "3.1.5",
    "ulid": "^3.0.2",
    "which": "6.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/stopword": "2.0.3",
    "@types/tcp-port-used": "1.0.4",
    "@types/which": "3.0.4",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "63.3.3",
    "fkill": "10.0.3",
    "jsdom": "30.1.2",
    "knip": "6.42.1",
    "mdast-util-from-markdown": "2.1.0",
    "npm-run-all2": "8.0.4",
    "p-map": "7.1.0",
    "p-queue": "9.3.3",
    "pid-port": "2.2.0",
    "playwright-core": "1.64.0",
    "prettier": "3.9.9",
    "ps-list": "9.0.0",
    "tcp-port-used": "1.0.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "^5.0.3"
  }
}
