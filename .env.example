# Copy to .env. Never commit .env. The worker and the evals read this file at start; src/env.ts is the one reader.
# Lookup order: next to the database (--db), then the wikis root (--wikis), then the project root. The first file found
# is the only one read. A variable already set in the environment is never overwritten.
# Every variable is optional. An empty value counts as absent.

# --- Credentials ---

# Local mode: a long-lived Claude Code token for the worker and the evals (`claude -p` without a terminal).
# Mint it with `claude setup-token`. The subscription terms allow this for local experiments only.
CLAUDE_CODE_OAUTH_TOKEN=

# Deployed mode: the Claude API key. With it set, the worker and the evals use the SDK transport.
ANTHROPIC_API_KEY=

# Alternatives that the evals accept as a credential: an auth token, or a config directory with a login.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_CONFIG_DIR=

# --- Transport ---

# Force the transport: `sdk` (the Claude API) or `cli` (`claude -p`). Default: sdk with an API key, else cli.
WIKIFACT_TRANSPORT=

# The path of the `claude` binary. Default: found on PATH or in the usual install folders.
WIKIFACT_CLAUDE_BIN=

# `1` runs `claude -p --bare`, which reads no login from the keychain; needs an API key. Default: off.
WIKIFACT_CLI_BARE=

# --- Configuration ---

# Another presets file instead of config/presets.json.
WIKIFACT_PRESETS=

# --- Diagnostics ---

# `1` logs every question call with its input, context and output, one JSON line per call, on stderr. It matters
# only without a log directory: a worker with one always writes the calls to `worker-<wiki>-calls.log`.
WIKIFACT_LOG_CALLS=

# The corrections eval sets this for its stop hook: a file that the hook appends one JSON line per run to.
WIKIFACT_HOOK_LOG=
